% plot(geom_2D.x_cam_all,  geom_2D.r_cam_all, 'k-', 'LineWidth', 2.0); hold on;
% plot(geom_2D.x_cam_all, -geom_2D.r_cam_all, 'k-', 'LineWidth', 2.0, 'HandleVisibility', 'off');
% plot(x_throat + geom_2D.x_TOP_ref,  geom_2D.r_TOP_ref, 'r--', 'LineWidth', 1.8);

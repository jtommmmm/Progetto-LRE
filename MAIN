% xline(geom_2D.xN_rel,   'm:', 'Salto in N (TOP)');
% xline(geom_2D.x_tr_rel, 'k-.', 'Transizione TIC\rightarrowTOP');
% yline(0, 'k:');
% xlim([0, min(1.0, geom_2D.L_noz)]); grid on;
% xlabel('Distanza Assiale dalla Gola x - x_t [m] (Zoom Primi 1.0 m)');
% ylabel('Gradiente di Rotazione Parete d\theta/dx [deg/m]');

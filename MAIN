%% ========================================================================
%  FUNZIONI LOCALI DI SUPPORTO VERIFICATE E CORRETTE
%  ========================================================================

function [Lc, L_conv] = calcola_lunghezza_camera(Rt, eps_c, L_star, theta_conv_deg)
% Calcola esattamente Lc (cilindro) e L_conv (convergente) dato il raggio di gola Rt
At = pi*Rt^2;
Ac = eps_c*At;
Rc = sqrt(Ac/pi);
Ru = 1.5*Rt;
th_conv = deg2rad(theta_conv_deg);

phi_u = linspace(-th_conv, 0, 50);
x_Ru_rel = Ru*sin(phi_u);
r_Ru = Rt + Ru*(1 - cos(phi_u));

x_u_in = x_Ru_rel(1);
r_u_in = r_Ru(1);
L_cone_part = (Rc - r_u_in)/tan(th_conv);
L_conv = L_cone_part + abs(x_u_in);

V_c_req = L_star*At;
V_cone_part = (pi*L_cone_part/3)*(Rc^2 + Rc*r_u_in + r_u_in^2);
V_Ru_part = trapz(x_Ru_rel, pi*r_Ru.^2);
V_conv = V_cone_part + V_Ru_part;
Lc = max((V_c_req - V_conv)/Ac, 0.15);
end

function out = estrai_dati_CEA_sicuro(res, eps_val, g0)
dati = res.output.eql;
T_vec = squeeze(dati.temperature);
gam_vec = squeeze(dati.gamma);
cstar_vec = squeeze(dati.cstar);

out.Tc = T_vec(1);
out.Tt = T_vec(2);
out.gam_c = gam_vec(1);
out.gam_t = gam_vec(2);
out.cstar_eq = cstar_vec(end);

if isfield(dati, 'isp_vac')
    ivac_raw = squeeze(dati.isp_vac);
else
    ivac_raw = squeeze(dati.ivac);
end
val_ivac = ivac_raw(end);
if val_ivac > 1000
    Ivac_ms = val_ivac;
    out.Isp_eq = val_ivac/g0;
else
    out.Isp_eq = val_ivac;
    Ivac_ms = val_ivac*g0;
end
out.CF_eq = Ivac_ms/out.cstar_eq;

% Calcolo analitico esatto espansione Frozen alla gola (nfz = 2)
g = out.gam_t;
f_area = @(M) (1./M).*((2/(g + 1)).*(1 + 0.5*(g - 1).*M.^2)).^((g + 1)/(2*(g - 1))) - eps_val;
Me = fzero(f_area, [1.01, 15.0]);
pe_pc = (1 + 0.5*(g - 1)*Me^2)^(-g/(g - 1));
Gamma_g = sqrt(g)*(2/(g + 1))^((g + 1)/(2*(g - 1)));
out.CF_froz = Gamma_g*sqrt((2*g/(g - 1))*(1 - pe_pc^((g - 1)/g))) + eps_val*pe_pc;
out.Isp_froz = (out.cstar_eq*out.CF_froz)/g0;
end

function [theta_N_deg, theta_E_deg, lambda_TOP, lambda_TIC_TOP] = parametri_Rao_TIC_TOP(eps_val, Ln, eps_tr)
% Carte parametriche di Rao per angoli di parete (theta_N, theta_E) per campana 80%
log_e = log10(max(eps_val, 5.0));
theta_N_deg = 22.5 + 6.2*log_e + 18.0*(0.80 - Ln);
theta_E_deg = max(14.5 - 3.6*log_e + 22.0*(0.80 - Ln), 4.0);

% 1. Efficienza geometrica/divergenza del solo TOP puro (include penalita' Rao shock in N)
th_eff_TOP = deg2rad(0.5*theta_E_deg + 0.12*(theta_N_deg - 28.0));
lambda_TOP = min(max(0.5*(1 + cos(th_eff_TOP)), 0.965), 0.995);

% 2. Modello Fisico del Trade-Off al variare di eps_tr (Punto di inizio del TOP)
eps_N_approx = 1.12;
f_shock_relief = 1 - exp(-max(eps_tr - eps_N_approx, 0)/1.10);
f_late_turning = max(0, (eps_tr - 3.6)/(0.18*eps_val))^1.6;

f_net_benefit = max(f_shock_relief - 0.85*f_late_turning, -0.5);
th_eff_TICTOP = deg2rad(0.5*theta_E_deg + 0.12*(theta_N_deg - 28.0)*(1 - 0.60*f_net_benefit));
delta_shock_gain = 0.0016*f_net_benefit;

lambda_TIC_TOP = min(max(0.5*(1 + cos(th_eff_TICTOP)) + delta_shock_gain, 0.965), 0.9965);
end

function geom = costruisci_camera_TIC_TOP(Rt, eps_val, Ln, eps_c, L_star, theta_conv_deg, theta_N_deg, theta_E_deg, eps_tr)
At = pi*Rt^2;
Ac = eps_c*At;
Rc = sqrt(Ac/pi);
Re = Rt*sqrt(eps_val);
Ru = 1.5*Rt;
Rd = 0.382*Rt;
th_conv = deg2rad(theta_conv_deg);

% 1. Arco subsonico di gola Ru (x_rel <= 0 rispetto alla gola)
phi_u = linspace(-th_conv, 0, 50);
x_Ru_rel = Ru*sin(phi_u);
r_Ru = Rt + Ru*(1 - cos(phi_u));

% 2. Tratto convergente conico e lunghezza cilindrica Lc da L* (Volume Esatto)
[Lc, L_conv] = calcola_lunghezza_camera(Rt, eps_c, L_star, theta_conv_deg);
L_cone_part = L_conv - abs(x_Ru_rel(1));

% 3. Arco supersonico di gola Rd fino al punto di inflessione N
thN = deg2rad(theta_N_deg);
thE = deg2rad(theta_E_deg);
phi_d = linspace(0, thN, 50);
x_Rd_rel = Rd*sin(phi_d);
r_Rd = Rt + Rd*(1 - cos(phi_d));

xN_rel = Rd*sin(thN);
yN = Rt + Rd*(1 - cos(thN));

% 4. Lunghezza divergente L_noz e costruzione SOLO TOP PURO (Eq. 163-164 Dispense)
alpha15 = deg2rad(15.0);
L_cone15 = (Rt*(sqrt(eps_val) - 1) + Rd*(1/cos(alpha15) - 1))/tan(alpha15);
L_noz = Ln*L_cone15;

mN = tan(thN); mE = tan(thE);
xQ_ref = (Re - yN - mE*L_noz + mN*xN_rel)/(mN - mE);
yQ_ref = yN + mN*(xQ_ref - xN_rel);
fx_ref = xQ_ref - xN_rel; cx_ref = L_noz - 2*xQ_ref + xN_rel;
fy_ref = yQ_ref - yN; cy_ref = Re - 2*yQ_ref + yN;

t_ref = linspace(0, 1, 280);
x_TOP_ref = xN_rel + 2*fx_ref*t_ref + cx_ref*(t_ref.^2);
r_TOP_ref = yN + 2*fy_ref*t_ref + cy_ref*(t_ref.^2);

% 5. PRIMA PARTE DIVERGENTE: PROFILO TIC DOLCE (da N fino a r_tr = Rt*sqrt(eps_tr))
eps_N_min = (yN/Rt)^2 + 0.02;
eps_tr_eff = max(eps_tr, eps_N_min);
r_tr = Rt*sqrt(eps_tr_eff);

frac_r = (r_tr - yN)/(Re - yN);
f_turn = min(max(0.18*(frac_r/0.10)^0.65, 0.02), 0.65);
theta_tr = thN - f_turn*(thN - thE);
m_tr = tan(theta_tr);

dx_tr = 3*(r_tr - yN)/(2*mN + m_tr);
c3_tic = (m_tr - mN)/(3*dx_tr^2);
x_tr_rel = xN_rel + dx_tr;

x_tic_rel = linspace(xN_rel, x_tr_rel, 80);
dx_loc = x_tic_rel - xN_rel;
r_tic = yN + mN*dx_loc + c3_tic*(dx_loc.^3);

% 6. SECONDA PARTE DIVERGENTE: PARABOLA TOP DI RAO (da T_tr fino all'uscita E)
xQ = (Re - r_tr - mE*L_noz + m_tr*x_tr_rel)/(m_tr - mE);
yQ = r_tr + m_tr*(xQ - x_tr_rel);
fx = xQ - x_tr_rel; cx = L_noz - 2*xQ + x_tr_rel;
fy = yQ - r_tr; cy = Re - 2*yQ + r_tr;

t_top = linspace(0, 1, 200);
x_top_rel = x_tr_rel + 2*fx*t_top + cx*(t_top.^2);
r_top = r_tr + 2*fy*t_top + cy*(t_top.^2);

% 7. Assemblaggio vettori globali del motore (x = 0 alla piastra di iniezione)
x_throat = Lc + L_conv;
x_cyl = linspace(0, Lc, 60);
r_cyl = Rc*ones(size(x_cyl));
x_con = linspace(Lc, Lc + L_cone_part, 60);
r_con = Rc - (x_con - Lc)*tan(th_conv);

geom.x_cam_all = [x_cyl(1:end - 1), x_con(1:end - 1), x_throat + x_Ru_rel(1:end - 1), x_throat + x_Rd_rel];
geom.r_cam_all = [r_cyl(1:end - 1), r_con(1:end - 1), r_Ru(1:end - 1), r_Rd];
geom.x_tic_rel = x_tic_rel;
geom.r_tic = r_tic;
geom.x_top_rel = x_top_rel;
geom.r_top = r_top;
geom.x_TOP_ref = x_TOP_ref;
geom.r_TOP_ref = r_TOP_ref;

geom.x_full = [geom.x_cam_all(1:end - 1), x_throat + x_tic_rel(1:end - 1), x_throat + x_top_rel];
geom.r_full = [geom.r_cam_all(1:end - 1), r_tic(1:end - 1), r_top];
geom.x_throat = x_throat;
geom.Rc = Rc;
geom.Re = Re;
geom.Lc = Lc;
geom.L_conv = L_conv;
geom.L_noz = L_noz;
geom.xN_rel = xN_rel;
geom.yN = yN;
geom.x_tr_rel = x_tr_rel;
geom.r_tr = r_tr;
geom.theta_tr_deg = rad2deg(theta_tr);

% 8. Calcolo pendenze theta(x) e gradiente d(theta)/dx per i grafici di confronto
x_div = [x_Rd_rel(1:end - 1), x_tic_rel(1:end - 1), x_top_rel];
r_div = [r_Rd(1:end - 1), r_tic(1:end - 1), r_top];
geom.x_div_rel = x_div;
geom.r_div_rel = r_div;
geom.theta_div_deg = rad2deg(atan(gradient(r_div, x_div)));
geom.dtheta_dx_TICTOP = gradient(geom.theta_div_deg, x_div);

x_div_ref = [x_Rd_rel(1:end - 1), x_TOP_ref];
r_div_ref = [r_Rd(1:end - 1), r_TOP_ref];
geom.x_div_TOP_only = x_div_ref;
geom.r_div_TOP_only = r_div_ref;
geom.theta_div_TOP_only = rad2deg(atan(gradient(r_div_ref, x_div_ref)));
geom.dtheta_dx_TOP_only = gradient(geom.theta_div_TOP_only, x_div_ref);

% Aree laterali divergenti a confronto
ds_1 = sqrt(diff(x_div).^2 + diff(r_div).^2);
rm_1 = 0.5*(r_div(1:end - 1) + r_div(2:end));
geom.A_lat_noz = sum(2*pi*rm_1.*ds_1);

ds_2 = sqrt(diff(x_div_ref).^2 + diff(r_div_ref).^2);
rm_2 = 0.5*(r_div_ref(1:end - 1) + r_div_ref(2:end));
geom.A_lat_TOP_only = sum(2*pi*rm_2.*ds_2);
end

function esporta_profilo_ANSYS(filename, x_in, r_in, N_pts)
% Rimuove eventuali punti duplicati e ricampiona con spline C^2 per ANSYS
[x_u, idx_u] = unique(x_in(:), 'stable');
r_u = r_in(idx_u);
r_u = r_u(:);

s_norm = linspace(0, 1, N_pts)';
x_out = interp1(linspace(0, 1, length(x_u))', x_u, s_norm, 'pchip');
r_out = interp1(x_u, r_u, x_out, 'pchip');

fid = fopen(filename, 'w');
fprintf(fid, '3d=true\n');
fprintf(fid, 'polyline=true\n');
for k = 1:N_pts
    % Formato: Gruppo(1) | Punto(k) | X [m] | Y [m] | Z [m]
    fprintf(fid, '1\t%d\t%.8f\t%.8f\t0.00000000\n', k, x_out(k), r_out(k));
end
fclose(fid);
end

function [T_wh_val, q_val, u_val, D_hyd, Re_val] = eval_Twh_canale(H, W, W_rib, N_chan, R_mid, t_wall, k_wall, ...
    m_dot_cool, rho_j, mu_j, k_j, Pr_j, hg_j, Taw_j, T_mid)
A_flow_tot = N_chan*W*H;
D_hyd = 2*W*H/(W + H);
u_val = m_dot_cool/(rho_j*A_flow_tot);
Re_val = rho_j*u_val*D_hyd/mu_j;
Nu_val = 0.023*Re_val^0.8*Pr_j^0.4;
hc_val = Nu_val*k_j/D_hyd;

m_fin = sqrt(2*hc_val/(k_wall*W_rib));
eta_fin = tanh(m_fin*H)/(m_fin*H);
Phi_A = N_chan*(W + 2*eta_fin*H)/(2*pi*R_mid);

R_th_tot = 1/hg_j + t_wall/k_wall + 1/(hc_val*Phi_A);
q_val = (Taw_j - T_mid)/R_th_tot;
T_wh_val = Taw_j - q_val/hg_j;
end

% legend('Solo TOP (Forte salto compressivo in N \rightarrow Shock)', ...
%     'TIC + TOP (Transizione continua d\theta/dx = 0 in N)', 'Location', 'southeast');
% 
% % --- FIGURA 3: Analisi Termica 1D (Numero di Mach, h_g di Bartz, Flusso q e Temperature) ---
% figure('Name', '3 - Analisi Scambio Termico Rigenerativo 1D (Bartz + Dittus-Boelter)', 'Color', 'w', 'Position', [100, 80, 1050, 580]);
% subplot(2,2,1);

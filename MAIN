% yyaxis right
% r_TOP_interp = interp1(geom_2D.x_div_TOP_only, geom_2D.r_div_TOP_only, geom_2D.x_div_rel, 'pchip');
% delta_r_mm = (geom_2D.r_div_rel - r_TOP_interp)*1000;

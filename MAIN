clear
clc
close all

%% 1. DATI DI PROGETTO, VINCOLI DI MISSIONE E ARCHITETTURA
m_pay     = 30000;          % Massa del payload [kg] (30 t)
dV_req    = 4500;           % Delta V richiesto [m/s]
TW0       = 0.8;            % Thrust-to-Weight ratio iniziale [-]
L_eng_max = 3.0;            % Lunghezza MAX TOTALE dalla piastra di iniezione (Lc + Lconv + Lnoz) [m]
D_stg_max = 5.0;            % Diametro massimo dello stadio [m]
g0        = 9.80665;        % Accelerazione di gravita' standard [m/s^2]

% Opzioni di esecuzione
N_engines      = 3;         % Numero di motori (1 oppure cluster es. 3)
genera_grafici = true;      % true = mostra le 4 figure | false = solo calcoli ed export

% Fattore geometrico esatto di impacchettamento ugelli circolari nel diametro stadio
switch N_engines
    case 1, k_pack = 1.0;
    case 2, k_pack = 2.0;
    case 3, k_pack = 1.0 + 2.0/sqrt(3);
    case 4, k_pack = 1.0 + sqrt(2);
    otherwise, k_pack = sqrt(N_engines/0.75);
end

% Parametri geometrici camera di combustione (fissati per calcolare Lc + Lconv nel ciclo)
eps_c      = 4.0;           % Rapporto di contrazione camera Ac/At [-]
L_star     = 0.90;          % Lunghezza caratteristica camera L* [m]
theta_conv = 35.0;          % Angolo semi-apertura convergente [deg]

% Proprieta' propellenti criogenici nei serbatoi (LOX / LH2)
rho_LH2   = 71.4;           % Densita' LH2 [kg/m^3]
rho_LOX   = 1141.0;         % Densita' LOX [kg/m^3]
T_LH2_in  = 20.27;          % Temperatura stoccaggio LH2 [K]
T_LOX_in  = 90.17;          % Temperatura stoccaggio LOX [K]
cp_H2     = 14350;          % Calore specifico medio GH2 in turbina [J/(kg*K)]
gam_H2    = 1.40;           % Coefficiente isentropico GH2 in turbina [-]

% Efficienze reali camera/ugello e parametri geometrici TOP
eta_cstar = 0.988;          % Efficienza di combustione c* [-]
eta_bl_0  = 0.990;          % Efficienza viscosa strato limite nell'ugello [-]
eps_s_ref = 0.10;           % Frazione massa strutturale serbatoi/stadio a O/F = 6.0
Ln_TOP    = 0.80;           % Lunghezza frazionaria Ugello TOP (80% cono 15°)

%% 2. PARAMETRI CICLO CLOSED EXPANDER SPLIT-FLOW
eta_P_F   = 0.80;           % Rendimento isentropico pompe Fuel (1° e 2° stadio)
eta_P_O   = 0.75;           % Rendimento isentropico pompa Oxidizer
eta_T     = 0.80;           % Rendimento isentropico turbina
a_FC      = 1.20;           % Perdite linea + iniettori ramo bypass (20%)
a_OC      = 1.20;           % Perdite linea + iniettori ossidante (20%)
a_FPB     = 1.45;           % Perdite linea + canali di raffreddamento (45%)
a_T       = 1.20;           % Rapporto contropressione scarico turbina p_out,T / p_c

% Coefficienti di lavoro specifico di pompaggio b [m^3/kg]
b_FC  = a_FC/(rho_LH2*eta_P_F);
b_OC  = a_OC/(rho_LOX*eta_P_O);
b_FPB = a_FPB/(rho_LH2*eta_P_F);

% Calore specifico scambiato nel circuito rigenerativo per kg di fuel totale
Q_dot_m_dot_F = 2.45e6;     % [J/kg_F] (verificato a valle in Sezione 7)
T_0T_max_lim  = 600.0;      % Limite tecnologico temperatura ingresso turbina [K]

% Studio preliminare della Curva Caratteristica pc(tau) per scegliere tau ottimo
tau_scan  = linspace(0.65, 0.95, 250);
xF_design = 0.60;           % Split-Flow di riferimento: 60% H2 in turbina, 40% bypass
OF_ref    = 6.0;

T_0T_scan   = min(T_LH2_in + Q_dot_m_dot_F/(xF_design*cp_H2), T_0T_max_lim);
w_T_scan    = xF_design*eta_T*cp_H2*T_0T_scan.*(1 - tau_scan);
den_scan    = (1 - xF_design)*b_FC + OF_ref*b_OC + ...
              xF_design*b_FPB*a_T.*tau_scan.^(-gam_H2/(gam_H2 - 1));
pc_scan_bar = (w_T_scan./den_scan)/1e5;

[pc_peak_bar, idx_tau] = max(pc_scan_bar);
tau_opt  = tau_scan(idx_tau);               % Rapporto di temperatura isentropico ottimo in turbina
pi_T_opt = tau_opt^(-gam_H2/(gam_H2 - 1));  % Rapporto di espansione in turbina

fprintf('=========================================================================\n');
fprintf('  1. OTTIMIZZAZIONE CICLO CLOSED EXPANDER SPLIT-FLOW (x_F = %.2f)\n', xF_design);
fprintf('=========================================================================\n');
fprintf('  Temperatura ingresso turbina (T_0T) : %.1f K\n', T_0T_scan);
fprintf('  Rapporto temp. turbina ottimo (tau) : %.3f (Rapporto espansione pi_T = %.2f)\n', tau_opt, pi_T_opt);
fprintf('  Pressione max teorica a O/F = 6.0   : %.2f bar\n', pc_peak_bar);
fprintf('=========================================================================\n\n');

%% 3. ANALISI PARAMETRICA ACCOPPIATA IN NASA CEA (Ugello TOP, Vincolo L_tot <= 3.0 m)
Pc_bar = round(0.90*pc_peak_bar);
P_c    = Pc_bar*1e5;                % Pressione operativa in camera [Pa]

OF_vec = 4.0 : 0.25 : 7.0;          % Range O/F di interesse per LOX/LH2
N_OF   = length(OF_vec);

% Preallocazione vettori risultati (Profilo TOP)
xF_vec       = zeros(1, N_OF);
T_in_T_vec   = zeros(1, N_OF);
T_inj_vec    = zeros(1, N_OF);
eps_opt_vec  = zeros(1, N_OF);
Tc_vec       = zeros(1, N_OF);
cstar_eq_vec = zeros(1, N_OF);
cstar_re_vec = zeros(1, N_OF);
CF_eq_vec    = zeros(1, N_OF);
CF_froz_vec  = zeros(1, N_OF);
CF_re_vec    = zeros(1, N_OF);
Isp_eq_vec   = zeros(1, N_OF);
Isp_froz_vec = zeros(1, N_OF);
Isp_re_vec   = zeros(1, N_OF);
m0_t_vec     = zeros(1, N_OF);
mp_t_vec     = zeros(1, N_OF);
V_tanks_vec  = zeros(1, N_OF);
Dt_vec       = zeros(1, N_OF);
De_vec       = zeros(1, N_OF);
L_noz_vec    = zeros(1, N_OF);
L_tot_vec    = zeros(1, N_OF);      % Lunghezza totale motore (Lc + Lconv + Lnoz) [m]

rho_ref_6 = (1 + 6.0)/(1/rho_LH2 + 6.0/rho_LOX);

fprintf('Esecuzione analisi termochimica NASA CEA (Ugello TOP, Vincolo L_tot <= %.2f m)...\n', L_eng_max);

for i = 1:N_OF
    OF = OF_vec(i);

    % 1. Bilancio di potenza esatto del ciclo Closed Expander
    f_pow = @(x) eta_T*(x*cp_H2*T_LH2_in + Q_dot_m_dot_F)*(1 - tau_opt) ...
                 - P_c*((1 - x)*b_FC + OF*b_OC + x*b_FPB*a_T*pi_T_opt);

    x_sol     = fzero(f_pow, 0.50);
    x_sol     = min(max(x_sol, 0.15), 0.98);
    xF_vec(i) = x_sol;
    x_bypass  = 1.0 - x_sol;

    % Temperature ingresso e uscita turbina
    T_in_T_vec(i) = T_LH2_in + Q_dot_m_dot_F/(cp_H2*x_sol);
    T_out_T_real  = T_in_T_vec(i)*(1 - eta_T*(1 - tau_opt));
    T_inj_vec(i)  = T_out_T_real;

    % Penalita' strutturale serbatoi in funzione della Bulk Density
    rho_bulk = (1 + OF)/(1/rho_LH2 + OF/rho_LOX);
    eps_s    = eps_s_ref*(rho_ref_6/rho_bulk)^0.30;

    % 2. Ciclo di convergenza per trovare eps_max che rispetta L_tot = Lc + Lconv + Lnoz <= 3 m
    eps_guess = 100;
    err = 1.0; iter = 0;

    while (err > 1e-3) && (iter < 100)
        iter = iter + 1;
        eps_safe = max(eps_guess, 5.0);

        rkt = CEA('problem', 'rocket', 'equilibrium', ...
            'case', 'Expander_Split_TOP', ...
            'p,bar', Pc_bar, ...
            'o/f', OF, ...
            'supar', eps_safe, ...
            'reactants', ...
            'oxid', 'O2(L)', 'wt%', 100.0,            't(k)', T_LOX_in, ...
            'fuel', 'H2(L)', 'wt%', x_bypass*100.0,   't(k)', T_LH2_in, ...
            'fuel', 'H2',    'wt%', x_sol*100.0,      't(k)', T_out_T_real, ...
            'output', 'mks', 'transport', 'short', 'end');

        cea_out = estrai_dati_CEA_sicuro(rkt, eps_safe, g0);

        % Parametri angolari ed efficienza 2D del profilo TOP
        [~, ~, lam_TOP] = parametri_TOP(eps_safe, Ln_TOP);

        CF_kin   = (2/3)*cea_out.CF_eq + (1/3)*cea_out.CF_froz;
        cstar_re = eta_cstar*cea_out.cstar_eq;
        CF_re    = CF_kin*lam_TOP*eta_bl_0;
        Isp_re   = (cstar_re*CF_re)/g0;

        % Equazione di Tsiolkovsky e Spinta per singolo motore
        MR       = exp(dV_req/(Isp_re*g0));
        m0_stg   = m_pay*MR*(1 - eps_s)/(1 - eps_s*MR);
        F_tot    = TW0*m0_stg*g0;
        F_single = F_tot/N_engines;

        % Raggio di gola singolo motore
        At_single = F_single/(P_c*CF_re);
        Rt_single = sqrt(At_single/pi);

        % Calcolo esatto di Lc + Lconv (dalla piastra di iniezione alla gola)
        [Lc_loc, Lconv_loc] = calcola_lunghezza_camera(Rt_single, eps_c, L_star, theta_conv);
        L_noz_avail = max(L_eng_max - (Lc_loc + Lconv_loc), 0.50);

        alpha15 = deg2rad(15.0);
        term_Rd = 0.382*(1/cos(alpha15) - 1);
        eps_L   = (1 + (L_noz_avail*tan(alpha15))/(Ln_TOP*Rt_single) - term_Rd)^2;
        eps_D   = (D_stg_max/(2*Rt_single*k_pack))^2;

        eps_new   = min([eps_L, eps_D, 300.0]);
        err       = abs(eps_new - eps_safe);
        eps_guess = eps_new;
    end

    % Salvataggio nei vettori
    eps_opt_vec(i)  = eps_guess;
    Tc_vec(i)       = cea_out.Tc;
    cstar_eq_vec(i) = cea_out.cstar_eq;
    cstar_re_vec(i) = cstar_re;
    CF_eq_vec(i)    = cea_out.CF_eq;
    CF_froz_vec(i)  = cea_out.CF_froz;
    CF_re_vec(i)    = CF_re;
    Isp_eq_vec(i)   = cea_out.Isp_eq;
    Isp_froz_vec(i) = cea_out.Isp_froz;
    Isp_re_vec(i)   = Isp_re;
    m0_t_vec(i)     = m0_stg/1e3;
    mp_t_vec(i)     = (m0_stg*(1 - 1/MR))/1e3;
    V_tanks_vec(i)  = (mp_t_vec(i)*1e3)/rho_bulk;
    Dt_vec(i)       = 2*Rt_single;
    De_vec(i)       = 2*Rt_single*sqrt(eps_guess);
    L_noz_vec(i)    = Ln_TOP*(Rt_single*(sqrt(eps_guess) - 1) + 0.382*Rt_single*(1/cos(alpha15) - 1))/tan(alpha15);
    L_tot_vec(i)    = Lc_loc + Lconv_loc + L_noz_vec(i);
end

%% 4. SELEZIONE DEL PUNTO DI PROGETTO OTTIMO E RICALCOLO CEA DEDICATO
[m0_min_t, idx_opt] = min(m0_t_vec);

OF_opt   = OF_vec(idx_opt);
xF_opt   = xF_vec(idx_opt);
T_inj_op = T_inj_vec(idx_opt);
eps_opt  = eps_opt_vec(idx_opt);
Isp_opt  = Isp_re_vec(idx_opt);
cstar_op = cstar_re_vec(idx_opt);
CF_opt   = CF_re_vec(idx_opt);

if T_in_T_vec(idx_opt) > T_0T_max_lim
    warning('Temperatura ingresso turbina (%.1f K) superiore al limite tecnologico (%.1f K).', ...
        T_in_T_vec(idx_opt), T_0T_max_lim);
end

% Rilanciamo CEA esattamente nel punto ottimo OF_opt per le proprieta' di trasporto (Bartz)
rkt_opt = CEA('problem', 'rocket', 'equilibrium', ...
    'case', 'Design_Point_Exact', ...
    'p,bar', Pc_bar, ...
    'o/f', OF_opt, ...
    'supar', eps_opt, ...
    'reactants', ...
    'oxid', 'O2(L)', 'wt%', 100.0,              't(k)', T_LOX_in, ...
    'fuel', 'H2(L)', 'wt%', (1 - xF_opt)*100.0, 't(k)', T_LH2_in, ...
    'fuel', 'H2',    'wt%', xF_opt*100.0,       't(k)', T_inj_op, ...
    'output', 'mks', 'transport', 'short', 'end');

%% 5. DIMENSIONAMENTO CAMERA E CONTORNO 2D UGELLO TOP
F_vac_tot  = m0_min_t*1e3*g0*TW0;                   % Spinta totale nel vuoto [N]
F_single   = F_vac_tot/N_engines;                   % Spinta singolo motore [N]
m_dot_tot  = F_vac_tot/(Isp_opt*g0);                % Portata totale stadio [kg/s]
m_dot_e    = m_dot_tot/N_engines;                   % Portata singolo motore [kg/s]
m_dot_F_e  = m_dot_e/(1 + OF_opt);                  % Portata fuel singolo motore [kg/s]
m_dot_cool = xF_opt*m_dot_F_e;                      % Portata H2 nei canali [kg/s]

At_e = F_single/(P_c*CF_opt);                       % Area di gola coerente con CF_reale [m^2]
Rt_e = sqrt(At_e/pi);                               % Raggio di gola [m]
Dt_e = 2*Rt_e;                                      % Diametro di gola [m]

[thN_opt, thE_opt, lam_TOP_opt] = parametri_TOP(eps_opt, Ln_TOP);
geom_2D = costruisci_camera_TOP(Rt_e, eps_opt, Ln_TOP, eps_c, L_star, ...
                                theta_conv, thN_opt, thE_opt);

L_tot_engine = geom_2D.Lc + geom_2D.L_conv + geom_2D.L_noz;

fprintf('\n================== PUNTO DI PROGETTO OTTIMO (N_eng = %d) ==================\n', N_engines);
fprintf('  Pressione in camera (P_c)         : %.1f bar\n', Pc_bar);
fprintf('  Rapporto di miscela ottimo (O/F)  : %.2f\n', OF_opt);
fprintf('  Frazione fuel in turbina (x_F)    : %.4f (%.1f%% in turbina, %.1f%% bypass)\n', xF_opt, xF_opt*100, (1 - xF_opt)*100);
fprintf('  Temp. uscita turbina / iniez. GH2 : %.1f K (Ingresso turbina: %.1f K)\n', T_inj_op, T_in_T_vec(idx_opt));
fprintf('  Rapporto di espansione (pi_T)     : %.2f\n', pi_T_opt);
fprintf('  Temp. camera di combustione (T_c) : %.1f K\n', Tc_vec(idx_opt));
fprintf('  Velocita'' caratteristica (c*)     : %.1f m/s (CEA)  -->  %.1f m/s (Reale)\n', cstar_eq_vec(idx_opt), cstar_op);
fprintf('  Coefficiente di spinta (C_F)      : %.4f (Eq) | %.4f (Froz) --> %.4f (Reale TOP)\n', CF_eq_vec(idx_opt), CF_froz_vec(idx_opt), CF_opt);
fprintf('  Impulso specifico vuoto (I_sp)    : %.2f s (Eq) | %.2f s (Froz) --> %.2f s (Reale TOP)\n', Isp_eq_vec(idx_opt), Isp_froz_vec(idx_opt), Isp_opt);
fprintf('  Spinta singolo motore / totale    : %.1f kN / %.1f kN\n', F_single/1e3, F_vac_tot/1e3);
fprintf('  Portata singolo motore / H2 cool  : %.2f kg/s / %.2f kg/s\n', m_dot_e, m_dot_cool);
fprintf('  Massa iniziale 2° stadio (m_0)    : %.2f t (Propellente: %.2f t, Payload: 30.00 t)\n', m0_min_t, mp_t_vec(idx_opt));
fprintf('  Volume totale serbatoi            : %.1f m^3\n', V_tanks_vec(idx_opt));
fprintf('  ------------------------------------------------------------------------\n');
fprintf('  GEOMETRIA CAMERA + UGELLO TOP (Vincolo L_tot <= %.2f m):\n', L_eng_max);
fprintf('  Diametro di gola (D_t)            : %.3f m (%.1f mm)\n', Dt_e, Dt_e*1000);
fprintf('  Diametro di camera (D_c)          : %.3f m (%.1f mm)\n', 2*geom_2D.Rc, 2000*geom_2D.Rc);
fprintf('  Diametro di uscita (D_e)          : %.3f m (eps = %.1f)\n', 2*geom_2D.Re, eps_opt);
fprintf('  Lunghezza cilindrica camera (L_c) : %.3f m\n', geom_2D.Lc);
fprintf('  Lunghezza convergente (L_conv)    : %.3f m (Gola a x_t = %.3f m)\n', geom_2D.L_conv, geom_2D.x_throat);
fprintf('  Lunghezza divergente TOP (L_noz)  : %.3f m\n', geom_2D.L_noz);
fprintf('  LUNGHEZZA TOTALE (Iniett.->Uscita): %.3f m (Vincolo <= %.2f m)\n', L_tot_engine, L_eng_max);
fprintf('  Angoli Parabola TOP               : theta_N = %.2f deg -> theta_E = %.2f deg (lambda = %.4f)\n', ...
    thN_opt, thE_opt, lam_TOP_opt);
fprintf('  Area laterale divergente (A_lat)  : %.2f m^2\n', geom_2D.A_lat_noz);
fprintf('==========================================================================\n\n');

%% 6. ANALISI SCAMBIO TERMICO 1D (BARTZ SUL PROFILO TOP PURO)
gamma_c = rkt_opt.output.eql.gamma(1);
gamma_t = rkt_opt.output.eql.gamma(2);
Tc_opt  = rkt_opt.output.eql.temperature(1);
Cp_c    = rkt_opt.output.eql.cp(1)*1e3;             % Conversione kJ/(kg K) -> J/(kg K)

mu_raw = rkt_opt.output.eql.viscosity(1);
if mu_raw > 1e-2
    mu_c = mu_raw*1e-7;                             % Da micropoise a Pa*s
else
    mu_c = mu_raw;
end
if isfield(rkt_opt.output.eql, 'prandtl')
    Pr_c = rkt_opt.output.eql.prandtl.eql(1);
else
    Pr_c = 0.55;
end

% Vettori geometrici continui lungo tutto il motore TOP (x = 0 all'iniettore)
x_vec    = geom_2D.x_full;
R_vec    = geom_2D.r_full;
x_throat = geom_2D.x_throat;
A_vec    = pi*R_vec.^2;
eps_x    = A_vec/At_e;
N_pts    = length(x_vec);

M_vec    = zeros(1, N_pts);
T_aw_vec = zeros(1, N_pts);
h_g_vec  = zeros(1, N_pts);
h_g_base = zeros(1, N_pts);

R_curv_throat = 0.5*(1.5 + 0.382)*Rt_e;
r_rec         = Pr_c^(1/3);                         % Fattore di recupero turbolento
T_wh_target   = 950.0;                              % Temp. parete calda di progetto [K]

for j = 1:N_pts
    eps_loc = max(eps_x(j), 1.0001);
    if abs(x_vec(j) - x_throat) < 1e-5 || eps_x(j) <= 1.0002
        M_vec(j) = 1.0;
    elseif x_vec(j) < x_throat
        f_sub = @(M) (1./M).*((2/(gamma_c + 1)).*(1 + 0.5*(gamma_c - 1).*M.^2)).^((gamma_c + 1)/(2*(gamma_c - 1))) - eps_loc;
        M_vec(j) = fzero(f_sub, [1e-4, 0.9999]);
    else
        f_sup = @(M) (1./M).*((2/(gamma_t + 1)).*(1 + 0.5*(gamma_t - 1).*M.^2)).^((gamma_t + 1)/(2*(gamma_t - 1))) - eps_loc;
        M_vec(j) = fzero(f_sup, [1.0001, 15.0]);
    end

    if x_vec(j) <= x_throat
        gam_loc = gamma_c;
    else
        gam_loc = gamma_t;
    end

    M_loc       = M_vec(j);
    T_aw_vec(j) = Tc_opt*(1 + r_rec*0.5*(gam_loc - 1)*M_loc^2)/(1 + 0.5*(gam_loc - 1)*M_loc^2);

    term1   = 0.5*(T_wh_target/Tc_opt)*(1 + 0.5*(gam_loc - 1)*M_loc^2) + 0.5;
    term2   = 1 + 0.5*(gam_loc - 1)*M_loc^2;
    sigma_B = 1/(term1^0.68*term2^0.12);

    h_g_base(j) = (0.026/Dt_e^0.2)*(P_c/cstar_op)^0.8*(mu_c^0.2*Cp_c/Pr_c^0.6) ...
                  *(At_e/A_vec(j))^0.9*(Dt_e/(2*R_curv_throat))^0.1;
    h_g_vec(j)  = h_g_base(j)*sigma_B;
end

%% 7. INTEGRAZIONE CIRCUITO DI RAFFREDDAMENTO (AUTO-CARICAMENTO TABELLE NIST + CHIUSURA PRESSIONE)
P_candidates = 150:10:300;
P_grid       = [];
nist_files   = {};
for p_val = P_candidates
    fname = sprintf('H2_%d.txt', p_val);
    if isfile(fname)
        P_grid(end + 1)     = p_val; %#ok<SAGROW>
        nist_files{end + 1} = fname; %#ok<SAGROW>
    end
end
if length(P_grid) < 2
    error('Servono almeno 2 tabelle NIST (es. H2_170.txt ... H2_260.txt) nella cartella corrente.');
end

nP = length(P_grid);
nP = length(P_grid);
for k = 1:nP
    opts   = detectImportOptions(nist_files{k}, 'Delimiter', '\t', 'VariableNamingRule', 'preserve');
    T_data = readtable(nist_files{k}, opts);

    [T_k, idx_u] = unique(T_data{:, 1}, 'stable'); % Temperature del file k [K]
    rho_k        = T_data{idx_u, 3};               % Densita' [kg/m^3]
    cp_k         = T_data{idx_u, 9}*1e3;           % Da J/(g*K) -> J/(kg*K)
    mu_k         = T_data{idx_u, 12};              % Viscosita' [Pa*s]
    k_k          = T_data{idx_u, 13};              % Conducibilita' termica [W/(m*K)]

    if k == 1
        T_grid        = T_k;
        nT            = length(T_grid);
        RHO_tab       = zeros(nT, nP);
        CP_tab        = zeros(nT, nP);
        MU_tab        = zeros(nT, nP);
        K_tab         = zeros(nT, nP);
        RHO_tab(:, 1) = rho_k;
        CP_tab(:, 1)  = cp_k;
        MU_tab(:, 1)  = mu_k;
        K_tab(:, 1)   = k_k;
    else
        % Riallinea automaticamente ogni file sulla stessa griglia T_grid
        RHO_tab(:, k) = interp1(T_k, rho_k, T_grid, 'linear', 'extrap');
        CP_tab(:, k)  = interp1(T_k, cp_k,  T_grid, 'linear', 'extrap');
        MU_tab(:, k)  = interp1(T_k, mu_k,  T_grid, 'linear', 'extrap');
        K_tab(:, k)   = interp1(T_k, k_k,   T_grid, 'linear', 'extrap');
    end
end

% Parametri liner CuCrZr e geometria canali fresati
k_wall       = 323.0;                               % Conducibilita' liner CuCrZr [W/(m*K)]
t_wall       = 1.0e-3;                              % Spessore parete calda [m] (1.0 mm)
T_wh_limit   = 1000.0;                              % Limite termico strutturale CuCrZr [K]
eps_r        = 3.0e-6;                              % Scabrezza canali fresati [m] (3 micron)

N_chan       = 180;                                 % Numero canali lungo la circonferenza [-]
W_rib        = 1.0e-3;                              % Spessore nervatura costante [m] (1.0 mm)
H_min        = 1.0e-3;                              % Altezza minima fresabile [m] (1.0 mm)
H_max        = 8.0e-3;                              % Altezza massima fresabile [m] (8.0 mm)
eps_cool_end = 15.0;                                % Rapporto d'area inizio camicia rigenerativa [-]

idx_regen_end = find(eps_x >= eps_cool_end & x_vec > x_throat, 1, 'first');
if isempty(idx_regen_end)
    idx_regen_end = N_pts;
end

% Condizioni al contorno e ciclo di ricerca pressione ingresso cooling
T_in_cool     = 40.0;                               % Temperatura ingresso H2 nei canali [K]
P_out_target  = a_T*Pc_bar;                         % Contropressione richiesta allo scarico turbina [bar]
P_in_cool_bar = P_out_target*pi_T_opt + 20.0;       % Stima iniziale fisicamente coerente [bar]

err_P_cool = inf;
tol_P      = 1e-3;                                  % Tolleranza di chiusura pressione [bar]
iter_P     = 0;
max_iter_P = 50;

while (err_P_cool > tol_P) && (iter_P < max_iter_P)
    iter_P = iter_P + 1;

    q_flux     = zeros(1, N_pts);
    T_wh       = zeros(1, N_pts);
    T_co       = zeros(1, N_pts);
    P_co_bar   = zeros(1, N_pts);
    u_co_vec   = zeros(1, N_pts);
    W_chan_vec = zeros(1, N_pts);
    H_chan_vec = zeros(1, N_pts);
    dQ_vec     = zeros(1, N_pts);
    rho_vec    = zeros(1, N_pts);
    mu_vec     = zeros(1, N_pts);

    T_co(idx_regen_end)     = T_in_cool;
    P_co_bar(idx_regen_end) = P_in_cool_bar;

    for j = (idx_regen_end - 1):-1:1
        dx     = x_vec(j + 1) - x_vec(j);
        dR     = R_vec(j + 1) - R_vec(j);
        ds     = sqrt(dx^2 + dR^2);
        R_mid  = 0.5*(R_vec(j) + R_vec(j + 1));
        dA_gas = 2*pi*R_mid*ds;

        % Larghezza locale canale con nervatura costante W_rib = 1 mm
        W_chan_loc = max(2*pi*(R_mid + t_wall)/N_chan - W_rib, 0.3e-3);

        if x_vec(j) <= x_throat
            gam_loc = gamma_c;
        else
            gam_loc = gamma_t;
        end
        M_loc = M_vec(j);

        % Stima iniziale per iterazione locale sulla stazione j
        T_co_guess = T_co(j + 1);
        P_co_guess = P_co_bar(j + 1);
        T_wh_loc   = T_wh_target;
        err_loc    = 1.0;
        iter_loc   = 0;

        while (err_loc > 1e-3) && (iter_loc < 30)
            iter_loc = iter_loc + 1;
            T_mid = min(max(0.5*(T_co(j + 1) + T_co_guess), T_grid(1)), T_grid(end));
            P_mid = min(max(0.5*(P_co_bar(j + 1) + P_co_guess), P_grid(1)), P_grid(end));

            % 1. Proprieta' locali H2 supercritico da tabelle NIST
            rho_j = interp2(P_grid, T_grid, RHO_tab, P_mid, T_mid, 'linear');
            cp_j  = interp2(P_grid, T_grid, CP_tab,  P_mid, T_mid, 'linear');
            mu_j  = interp2(P_grid, T_grid, MU_tab,  P_mid, T_mid, 'linear');
            k_j   = interp2(P_grid, T_grid, K_tab,   P_mid, T_mid, 'linear');
            Pr_j  = mu_j*cp_j/k_j;

            % 2. Aggiornamento sigma_B di Bartz con T_wh_loc
            term1   = 0.5*(T_wh_loc/Tc_opt)*(1 + 0.5*(gam_loc - 1)*M_loc^2) + 0.5;
            term2   = 1 + 0.5*(gam_loc - 1)*M_loc^2;
            sigma_B = 1/(term1^0.68*term2^0.12);
            hg_j    = h_g_base(j)*sigma_B;

            % 3. Dimensionamento H_chan_loc dal carico termico di progetto T_wh_target
            f_Twh = @(H) eval_Twh_canale(H, W_chan_loc, W_rib, N_chan, R_mid, t_wall, k_wall, ...
                         m_dot_cool, rho_j, mu_j, k_j, Pr_j, hg_j, T_aw_vec(j), T_mid) - T_wh_target;

            if f_Twh(H_max) <= 0
                H_chan_loc = H_max;
            elseif f_Twh(H_min) >= 0
                H_chan_loc = H_min;
            else
                H_chan_loc = fzero(f_Twh, [H_min, H_max]);
            end

            % 4. Calcolo grandezze finali al punto H_chan_loc scelto
            [T_wh_new, q_j, u_j, D_hyd_loc, Re_j] = eval_Twh_canale(H_chan_loc, W_chan_loc, W_rib, N_chan, ...
                R_mid, t_wall, k_wall, m_dot_cool, rho_j, mu_j, k_j, Pr_j, hg_j, T_aw_vec(j), T_mid);

            dQ_j     = q_j*dA_gas;
            T_co_new = T_co(j + 1) + dQ_j/(m_dot_cool*cp_j);

            % 5. Perdite di carico Darcy-Weisbach (Haaland)
            f_D      = (-1.8*log10((eps_r/(3.7*D_hyd_loc))^1.11 + 6.9/Re_j))^(-2);
            dP_Pa    = f_D*(ds/D_hyd_loc)*0.5*rho_j*u_j^2;
            P_co_new = P_co_bar(j + 1) - dP_Pa/1e5;

            err_loc    = max([abs(T_co_new - T_co_guess), abs(T_wh_new - T_wh_loc), abs(P_co_new - P_co_guess)]);
            T_co_guess = T_co_new;
            P_co_guess = P_co_new;
            T_wh_loc   = T_wh_new;
        end

        h_g_vec(j)    = hg_j;
        q_flux(j)     = q_j;
        T_wh(j)       = T_wh_loc;
        T_co(j)       = T_co_guess;
        P_co_bar(j)   = P_co_guess;
        u_co_vec(j)   = u_j;
        W_chan_vec(j) = W_chan_loc;
        H_chan_vec(j) = H_chan_loc;
        dQ_vec(j)     = dQ_j;
        rho_vec(j)    = rho_j;
        mu_vec(j)     = mu_j;
    end

    % Continuita' sul nodo di ingresso refrigerante
    T_wh(idx_regen_end)       = T_wh(idx_regen_end - 1);
    q_flux(idx_regen_end)     = q_flux(idx_regen_end - 1);
    W_chan_vec(idx_regen_end) = W_chan_vec(idx_regen_end - 1);
    H_chan_vec(idx_regen_end) = H_chan_vec(idx_regen_end - 1);
    u_co_vec(idx_regen_end)   = u_co_vec(idx_regen_end - 1);
    rho_vec(idx_regen_end)    = rho_vec(idx_regen_end - 1);
    mu_vec(idx_regen_end)     = mu_vec(idx_regen_end - 1);

    % Verifica bilancio pressioni a valle della turbina
    Q_dot_single     = sum(dQ_vec);                 % Potenza termica estratta [W]
    Q_dot_m_dot_calc = Q_dot_single/m_dot_F_e;      % Calore specifico per kg di fuel [J/kg]
    dP_cool_bar      = P_in_cool_bar - P_co_bar(1); % Caduta pressione totale canali [bar]
    P_in_t           = P_co_bar(1);                 % Pressione ingresso turbina [bar]
    P_out            = P_in_t/pi_T_opt;             % Pressione scarico turbina [bar]

    diff_P     = P_out - P_out_target;
    err_P_cool = abs(diff_P);

    % Aggiornamento adattivo rilassato (eseguito solo se serve un'altra iterazione)
    if (err_P_cool > tol_P) && (iter_P < max_iter_P)
        P_in_cool_bar = P_in_cool_bar - 0.8*diff_P*pi_T_opt;
    end
end

if P_in_cool_bar > P_grid(end) || P_co_bar(1) < P_grid(1)
    warning('Pressione nei canali [%.1f - %.1f bar] fuori dal range tabelle NIST caricate [%.0f - %.0f bar]: proprieta'' saturate ai bordi.', ...
        P_co_bar(1), P_in_cool_bar, P_grid(1), P_grid(end));
end

a_FPB_chan = P_in_cool_bar/P_in_t; % Rapporto perdite solo canali (confronto con a_FPB = 1.45)

fprintf('================== VALIDAZIONE SCAMBIO TERMICO (BARTZ + NIST) ==================\n');
fprintf('  Tabelle NIST caricate                     : %.0f - %.0f bar (%d file)\n', P_grid(1), P_grid(end), nP);
fprintf('  Convergenza pressione raggiunta in        : %d iterazioni (err = %.4f bar)\n', iter_P, err_P_cool);
fprintf('  Potenza termica estratta (singolo motore) : %.2f MW\n', Q_dot_single/1e6);
fprintf('  Q_dot / m_dot_F assunto nel ciclo         : %.2f MJ/kg\n', Q_dot_m_dot_F/1e6);
fprintf('  Q_dot / m_dot_F calcolato con Bartz+NIST  : %.2f MJ/kg\n', Q_dot_m_dot_calc/1e6);
fprintf('  Scarto di chiusura termica                : %.2f %%\n', abs(Q_dot_m_dot_calc - Q_dot_m_dot_F)/Q_dot_m_dot_F*100);
fprintf('  Temp. max parete calda (T_wh,max)         : %.1f K (Target: %.0f K | Limite: %.0f K)\n', ...
    max(T_wh(1:idx_regen_end)), T_wh_target, T_wh_limit);
fprintf('  Temp. uscita H2 dai canali (T_co,out)     : %.1f K (Assunta in turbina: %.1f K)\n', T_co(1), T_in_T_vec(idx_opt));
fprintf('  Pressione ingresso -> uscita canali       : %.2f -> %.2f bar (dP = %.2f bar)\n', ...
    P_in_cool_bar, P_co_bar(1), dP_cool_bar);
fprintf('  Pressione scarico turbina (target %.1f)   : %.2f bar (P_in/P_turb = %.3f vs a_FPB = %.2f)\n', ...
    P_out_target, P_out, a_FPB_chan, a_FPB);
fprintf('  Altezza canali H_chan (Min -> Camera)     : %.2f mm -> %.2f mm\n', ...
    min(H_chan_vec(1:idx_regen_end))*1e3, H_chan_vec(1)*1e3);
fprintf('  Velocita'' max H2 nei canali (u_co,max)    : %.1f m/s\n', max(u_co_vec(1:idx_regen_end)));
fprintf('================================================================================\n\n');

%% 7B. VALORI LOCALI IN GOLA PER CFD CANALI DI RAFFREDDAMENTO
[~, idx_throat] = min(abs(x_vec - x_throat));
u_chan_t   = u_co_vec(idx_throat);
rho_chan_t = rho_vec(idx_throat);
mu_chan_t  = mu_vec(idx_throat);
W_chan_t   = W_chan_vec(idx_throat);
H_chan_t   = H_chan_vec(idx_throat);

fprintf('================== DATI CANALE IN GOLA PER CFD (idx = %d) ==================\n', idx_throat);
fprintf('  Sezione canale (W x H)  : %.2f mm x %.2f mm\n', W_chan_t*1e3, H_chan_t*1e3);
fprintf('  Velocita'' H2 (u_co)     : %.2f m/s\n', u_chan_t);
fprintf('  Densita'' H2 (rho)       : %.2f kg/m^3\n', rho_chan_t);
fprintf('  Viscosita'' H2 (mu)      : %.3e Pa*s\n', mu_chan_t);
fprintf('  Pressione / Temp. H2    : %.2f bar / %.1f K\n', P_co_bar(idx_throat), T_co(idx_throat));
fprintf('============================================================================\n\n');

%% 8. GRAFICI COMPLETI PER LA RELAZIONE E PRESENTAZIONE
if genera_grafici
    % --- FIGURA 1: Analisi Parametrica O/F (CEA + Split-Flow + Masse Stadio) ---
    figure('Name', '1 - Analisi Parametrica O/F e Ottimizzazione Stadio (TOP)', 'Color', 'w', 'Position', [40, 60, 1060, 580]);
    subplot(2,2,1);
    plot(OF_vec, Tc_vec, 'r-o', 'LineWidth', 1.8); grid on;
    xlabel('Rapporto di Miscela O/F [-]'); ylabel('T_c [K]');
    title('Temperatura in Camera di Combustione (CEA)');

    subplot(2,2,2);
    plot(OF_vec, Isp_eq_vec,   'b--', 'LineWidth', 1.4); hold on;
    plot(OF_vec, Isp_froz_vec, 'k:',  'LineWidth', 1.4);
    plot(OF_vec, Isp_re_vec,   'r-s', 'LineWidth', 2.0); grid on;
    xlabel('Rapporto di Miscela O/F [-]'); ylabel('I_{sp,vac} [s]');
    title('Impulso Specifico nel Vuoto (Eq vs Frozen vs Reale TOP)');
    legend('CEA Equilibrium', 'CEA Frozen Gola', 'Reale TOP', 'Location', 'southwest');

    subplot(2,2,3);
    plot(OF_vec, xF_vec*100, 'm-d', 'LineWidth', 1.8); grid on;
    yline(100, 'r--', 'Limite Full-Flow (100%)');
    xlabel('Rapporto di Miscela O/F [-]'); ylabel('Frazione Fuel in Turbina x_F [%]');
    title(sprintf('Frazione Split-Flow x_F richiesta a P_c = %d bar', Pc_bar));

    subplot(2,2,4);
    yyaxis left
    plot(OF_vec, m0_t_vec, 'b-o', 'LineWidth', 2.0); hold on;
    plot(OF_opt, m0_min_t, 'kp',  'MarkerSize', 14, 'MarkerFaceColor', 'y');
    ylabel('Massa Iniziale 2° Stadio m_0 [t]');
    yyaxis right
    plot(OF_vec, V_tanks_vec, 'r-s', 'LineWidth', 1.8);
    ylabel('Volume Totale Serbatoi V_{tanks} [m^3]');
    xlabel('Rapporto di Miscela O/F [-]');
    title('Massa Iniziale Stadio m_0 e Volume Serbatoi');
    legend('m_0 (TOP)', 'Punto Ottimo', 'V_{tanks}', 'Location', 'northwest');
    grid on;

    % --- FIGURA 2: Profilo Geometrico 2D e Pendenza di Parete (Solo TOP) ---
    figure('Name', '2 - Profilo Geometrico 2D Camera e Ugello TOP', 'Color', 'w', 'Position', [70, 70, 1100, 480]);

    subplot(1,2,1);
    plot(geom_2D.x_cam_all,  geom_2D.r_cam_all, 'k-', 'LineWidth', 2.0); hold on;
    plot(geom_2D.x_cam_all, -geom_2D.r_cam_all, 'k-', 'LineWidth', 2.0, 'HandleVisibility', 'off');
    plot(x_throat + geom_2D.x_top_rel,  geom_2D.r_top, 'b-', 'LineWidth', 2.2);
    plot(x_throat + geom_2D.x_top_rel, -geom_2D.r_top, 'b-', 'LineWidth', 2.2, 'HandleVisibility', 'off');
    xline(x_throat, 'r:', 'Gola', 'LineWidth', 1.2);
    xline(x_vec(idx_regen_end), 'c-.', sprintf('Fine Cooling (\\epsilon=%.0f)', eps_cool_end), 'LineWidth', 1.3);
    plot(x_throat + geom_2D.xN_rel, geom_2D.yN, 'ms', 'MarkerSize', 7, 'MarkerFaceColor', 'm');
    yline(0, 'k:', 'HandleVisibility', 'off');
    axis equal; grid on;
    xlabel('Coordinata Assiale x dalla Piastra di Iniezione [m]'); ylabel('Raggio Locale r [m]');
    title(sprintf('Contorno 2D Motore Completo TOP (L_{tot} = %.2f m, \\epsilon = %.1f)', L_tot_engine, eps_opt));
    legend('Camera + Gola (R_u, R_d)', 'Parabola TOP', 'Gola', ...
           sprintf('Fine Cooling (\\epsilon=%.0f)', eps_cool_end), 'Punto Inflessione N', 'Location', 'northwest');

    subplot(1,2,2);
    plot(geom_2D.x_div_rel, geom_2D.theta_div_deg, 'b-', 'LineWidth', 2.2); hold on;
    xline(geom_2D.xN_rel, 'm:', 'Punto N (\theta_N)');
    grid on;
    xlabel('Distanza Assiale dalla Gola x - x_t [m]');
    ylabel('Angolo Locale di Parete \theta(x) [deg]');
    title('Andamento Pendenza di Parete \theta(x) - Profilo TOP');

    % --- FIGURA 3: Analisi Termica 1D (Numero di Mach, h_g di Bartz, Flusso q e Temperature) ---
    figure('Name', '3 - Analisi Scambio Termico Rigenerativo 1D (Bartz + NIST)', 'Color', 'w', 'Position', [100, 80, 1050, 580]);
    subplot(2,2,1);
    plot(x_vec, M_vec, 'k-', 'LineWidth', 1.8); grid on;
    xline(x_throat, 'r--', 'Gola');
    xlabel('Coordinata Assiale x dalla Piastra di Iniezione [m]'); ylabel('Mach Locale M(x) [-]');
    title('Profilo del Numero di Mach Lungo Camera e Ugello TOP');

    subplot(2,2,2);
    plot(x_vec, h_g_vec/1e3, 'r-', 'LineWidth', 1.8); grid on;
    xline(x_throat, 'k--', 'Gola');
    xlabel('Coordinata Assiale x dalla Piastra di Iniezione [m]'); ylabel('h_g(x) [kW/(m^2\cdotK)]');
    title('Coefficiente Convettivo Lato Gas Caldi (Bartz)');

    subplot(2,2,3);
    plot(x_vec(1:idx_regen_end), q_flux(1:idx_regen_end)/1e6, 'm-', 'LineWidth', 2.0); grid on;
    xline(x_throat, 'k--', 'Gola');
    xlabel('Coordinata Assiale x dalla Piastra di Iniezione [m]'); ylabel('Flusso Termico q(x) [MW/m^2]');
    title('Flusso Termico Locale alla Parete (Zona Raffreddata)');

    subplot(2,2,4);
    plot(x_vec(1:idx_regen_end), T_wh(1:idx_regen_end), 'r-', 'LineWidth', 2.0); hold on;
    plot(x_vec(1:idx_regen_end), T_co(1:idx_regen_end), 'b-', 'LineWidth', 2.0);
    yline(T_wh_limit, 'k--', 'Limite CuCrZr (1000 K)', 'LineWidth', 1.4);
    xline(x_throat, 'k:', 'Gola'); grid on;
    xlabel('Coordinata Assiale x dalla Piastra di Iniezione [m]'); ylabel('Temperatura [K]');
    title('Temperatura Parete Calda T_{wh}(x) e Refrigerante T_{co}(x)');
    legend('T_{wh} (Parete Calda Rame)', 'T_{co} (Idrogeno nei Canali)', 'Limite 1000 K', 'Location', 'northwest');

    % --- FIGURA 4: Geometria e Fluidodinamica dei Canali di Raffreddamento ---
    figure('Name', '4 - Dimensionamento Canali di Raffreddamento (NIST)', 'Color', 'w', 'Position', [130, 90, 1050, 480]);
    subplot(1,2,1);
    plot(x_vec(1:idx_regen_end), H_chan_vec(1:idx_regen_end)*1e3, 'b-', 'LineWidth', 2.0); hold on;
    plot(x_vec(1:idx_regen_end), W_chan_vec(1:idx_regen_end)*1e3, 'r--', 'LineWidth', 1.8);
    xline(x_throat, 'k:', 'Gola'); grid on;
    xlabel('Coordinata Assiale x [m]'); ylabel('Dimensione Canale [mm]');
    title('Altezza H_{chan}(x) e Larghezza W_{chan}(x) dei Canali');
    legend('Altezza H_{chan}', 'Larghezza W_{chan}', 'Location', 'northwest');

    subplot(1,2,2);
    yyaxis left
    plot(x_vec(1:idx_regen_end), P_co_bar(1:idx_regen_end), 'b-', 'LineWidth', 2.0);
    ylabel('Pressione H_2 nei Canali P_{co} [bar]');
    yyaxis right
    plot(x_vec(1:idx_regen_end), u_co_vec(1:idx_regen_end), 'm-', 'LineWidth', 1.8);
    ylabel('Velocita'' H_2 nei Canali u_{co} [m/s]');
    xline(x_throat, 'k:', 'Gola'); grid on;
    xlabel('Coordinata Assiale x [m]');
    title('Caduta di Pressione e Velocita'' del Refrigerante');
end

%% 9. ESPORTAZIONE PROFILI PER ANSYS CFD (TXT in metri) E AUTODESK INVENTOR (XLSX/TXT in mm)
N_cfd_pts = 500;

% 9A. File 3D Curve per ANSYS SpaceClaim / DesignModeler (metri, formato testo)
esporta_profilo_ANSYS('ANSYS_Camera_Completa_TOP.txt', geom_2D.x_full,    geom_2D.r_full,    N_cfd_pts);
esporta_profilo_ANSYS('ANSYS_Solo_Divergente_TOP.txt', geom_2D.x_div_rel, geom_2D.r_div_rel, N_cfd_pts);

% 9B. File coordinate XYZ in millimetri per Autodesk Inventor (Excel reali)
scala     = 1000;
punti_TOP = scala*[geom_2D.x_full(:), geom_2D.r_full(:), zeros(numel(geom_2D.x_full), 1)];
writematrix(punti_TOP, 'Inventor_TOP_Puro.xlsx');

% 9C. Profilo esterno e interno dei canali di raffreddamento TOP per Inventor (mm)
idx          = 1:(idx_regen_end - 1);
x_mid        = 0.5*(x_vec(idx) + x_vec(idx + 1));
R_mid        = 0.5*(R_vec(idx) + R_vec(idx + 1));
H_loc        = H_chan_vec(idx);
R_canale_int = R_mid + t_wall;
R_canale_est = R_mid + t_wall + H_loc;

punti_canale_est = scala*[x_mid(:), R_canale_est(:), zeros(numel(x_mid), 1)];
punti_canale_int = scala*[x_mid(:), R_canale_int(:), zeros(numel(x_mid), 1)];

writematrix(punti_canale_est, 'Canale_TOP_Puro.txt',  'Delimiter', 'tab');
writematrix(punti_canale_est, 'Canale_TOP_Puro.xlsx');
writematrix(punti_canale_int, 'Canale_Interno_TOP_Puro.xlsx');

fprintf('================== ESPORTAZIONE PROFILI ANSYS & INVENTOR ==================\n');
fprintf('  ANSYS CFD (500 punti, metri, 3D curve TXT):\n');
fprintf('  1) ANSYS_Camera_Completa_TOP.txt  (Iniettore x=0 -> Uscita x=%.3f m)\n', geom_2D.x_full(end));
fprintf('  2) ANSYS_Solo_Divergente_TOP.txt  (Gola x=0      -> Uscita x=%.3f m)\n', geom_2D.x_div_rel(end));
fprintf('  AUTODESK INVENTOR (coordinate XYZ in millimetri):\n');
fprintf('  3) Inventor_TOP_Puro.xlsx         (Contorno interno completo camera + TOP)\n');
fprintf('  4) Canale_TOP_Puro.xlsx / .txt    (Parete esterna canali: R + t_wall + H)\n');
fprintf('  5) Canale_Interno_TOP_Puro.xlsx   (Fondo canali: R + t_wall)\n');
fprintf('===========================================================================\n');

%% ========================================================================
%  FUNZIONI LOCALI DI SUPPORTO
%  ========================================================================

function [Lc, L_conv] = calcola_lunghezza_camera(Rt, eps_c, L_star, theta_conv_deg)
At      = pi*Rt^2;
Ac      = eps_c*At;
Rc      = sqrt(Ac/pi);
Ru      = 1.5*Rt;
th_conv = deg2rad(theta_conv_deg);

phi_u    = linspace(-th_conv, 0, 50);
x_Ru_rel = Ru*sin(phi_u);
r_Ru     = Rt + Ru*(1 - cos(phi_u));

x_u_in      = x_Ru_rel(1);
r_u_in      = r_Ru(1);
L_cone_part = (Rc - r_u_in)/tan(th_conv);
L_conv      = L_cone_part + abs(x_u_in);

V_c_req     = L_star*At;
V_cone_part = (pi*L_cone_part/3)*(Rc^2 + Rc*r_u_in + r_u_in^2);
V_Ru_part   = trapz(x_Ru_rel, pi*r_Ru.^2);
V_conv      = V_cone_part + V_Ru_part;
Lc          = max((V_c_req - V_conv)/Ac, 0.15);
end

function out = estrai_dati_CEA_sicuro(res, eps_val, g0)
dati      = res.output.eql;
T_vec     = squeeze(dati.temperature);
gam_vec   = squeeze(dati.gamma);
cstar_vec = squeeze(dati.cstar);

out.Tc       = T_vec(1);
out.Tt       = T_vec(2);
out.gam_c    = gam_vec(1);
out.gam_t    = gam_vec(2);
out.cstar_eq = cstar_vec(end);

if isfield(dati, 'isp_vac')
    ivac_raw = squeeze(dati.isp_vac);
else
    ivac_raw = squeeze(dati.ivac);
end
val_ivac = ivac_raw(end);
if val_ivac > 1000
    Ivac_ms    = val_ivac;
    out.Isp_eq = val_ivac/g0;
else
    out.Isp_eq = val_ivac;
    Ivac_ms    = val_ivac*g0;
end
out.CF_eq = Ivac_ms/out.cstar_eq;

% Calcolo analitico esatto espansione Frozen alla gola (nfz = 2)
g            = out.gam_t;
f_area       = @(M) (1./M).*((2/(g + 1)).*(1 + 0.5*(g - 1).*M.^2)).^((g + 1)/(2*(g - 1))) - eps_val;
Me           = fzero(f_area, [1.01, 15.0]);
pe_pc        = (1 + 0.5*(g - 1)*Me^2)^(-g/(g - 1));
Gamma_g      = sqrt(g)*(2/(g + 1))^((g + 1)/(2*(g - 1)));
out.CF_froz  = Gamma_g*sqrt((2*g/(g - 1))*(1 - pe_pc^((g - 1)/g))) + eps_val*pe_pc;
out.Isp_froz = (out.cstar_eq*out.CF_froz)/g0;
end

function [theta_N_deg, theta_E_deg, lambda_TOP] = parametri_TOP(eps_val, Ln)
log_e       = log10(max(eps_val, 5.0));
theta_N_deg = 22.5 + 6.2*log_e + 18.0*(0.80 - Ln);
theta_E_deg = max(14.5 - 3.6*log_e + 22.0*(0.80 - Ln), 4.0);
th_eff_TOP  = deg2rad(0.5*theta_E_deg + 0.12*(theta_N_deg - 28.0));
lambda_TOP  = min(max(0.5*(1 + cos(th_eff_TOP)), 0.965), 0.995);
end

function geom = costruisci_camera_TOP(Rt, eps_val, Ln, eps_c, L_star, theta_conv_deg, theta_N_deg, theta_E_deg)
At      = pi*Rt^2;
Ac      = eps_c*At;
Rc      = sqrt(Ac/pi);
Re      = Rt*sqrt(eps_val);
Ru      = 1.5*Rt;
Rd      = 0.382*Rt;
th_conv = deg2rad(theta_conv_deg);

% 1. Arco subsonico di gola Ru (x_rel <= 0 rispetto alla gola)
phi_u    = linspace(-th_conv, 0, 50);
x_Ru_rel = Ru*sin(phi_u);
r_Ru     = Rt + Ru*(1 - cos(phi_u));

% 2. Tratto convergente conico e lunghezza cilindrica Lc da L* (Volume Esatto)
[Lc, L_conv] = calcola_lunghezza_camera(Rt, eps_c, L_star, theta_conv_deg);
L_cone_part  = L_conv - abs(x_Ru_rel(1));

% 3. Arco supersonico di gola Rd fino al punto di inflessione N
thN      = deg2rad(theta_N_deg);
thE      = deg2rad(theta_E_deg);
phi_d    = linspace(0, thN, 50);
x_Rd_rel = Rd*sin(phi_d);
r_Rd     = Rt + Rd*(1 - cos(phi_d));

xN_rel = Rd*sin(thN);
yN     = Rt + Rd*(1 - cos(thN));

% 4. Lunghezza divergente L_noz e costruzione Parabola TOP (Bezier quadratica da N ad E)
alpha15  = deg2rad(15.0);
L_cone15 = (Rt*(sqrt(eps_val) - 1) + Rd*(1/cos(alpha15) - 1))/tan(alpha15);
L_noz    = Ln*L_cone15;

mN = tan(thN); mE = tan(thE);
xQ = (Re - yN - mE*L_noz + mN*xN_rel)/(mN - mE);
yQ = yN + mN*(xQ - xN_rel);
fx = xQ - xN_rel; cx = L_noz - 2*xQ + xN_rel;
fy = yQ - yN;     cy = Re    - 2*yQ + yN;

t_top     = linspace(0, 1, 280);
x_top_rel = xN_rel + 2*fx*t_top + cx*(t_top.^2);
r_top     = yN     + 2*fy*t_top + cy*(t_top.^2);

% 5. Assemblaggio vettori globali del motore (x = 0 alla piastra di iniezione)
x_throat = Lc + L_conv;
x_cyl    = linspace(0, Lc, 60);
r_cyl    = Rc*ones(size(x_cyl));
x_con    = linspace(Lc, Lc + L_cone_part, 60);
r_con    = Rc - (x_con - Lc)*tan(th_conv);

geom.x_cam_all = [x_cyl(1:end - 1), x_con(1:end - 1), x_throat + x_Ru_rel(1:end - 1), x_throat + x_Rd_rel];
geom.r_cam_all = [r_cyl(1:end - 1), r_con(1:end - 1), r_Ru(1:end - 1), r_Rd];
geom.x_top_rel = x_top_rel;
geom.r_top     = r_top;

geom.x_full   = [geom.x_cam_all(1:end - 1), x_throat + x_top_rel];
geom.r_full   = [geom.r_cam_all(1:end - 1), r_top];
geom.x_throat = x_throat;
geom.Rc       = Rc;
geom.Re       = Re;
geom.Lc       = Lc;
geom.L_conv   = L_conv;
geom.L_noz    = L_noz;
geom.xN_rel   = xN_rel;
geom.yN       = yN;

% 6. Pendenza locale e area laterale del divergente TOP
x_div = [x_Rd_rel(1:end - 1), x_top_rel];
r_div = [r_Rd(1:end - 1),     r_top];
geom.x_div_rel     = x_div;
geom.r_div_rel     = r_div;
geom.theta_div_deg = rad2deg(atan(gradient(r_div, x_div)));

ds = sqrt(diff(x_div).^2 + diff(r_div).^2);
rm = 0.5*(r_div(1:end - 1) + r_div(2:end));
geom.A_lat_noz = sum(2*pi*rm.*ds);
end

function esporta_profilo_ANSYS(filename, x_in, r_in, N_pts)
[x_u, idx_u] = unique(x_in(:), 'stable');
r_u          = r_in(idx_u);
r_u          = r_u(:);

s_norm = linspace(0, 1, N_pts)';
x_out  = interp1(linspace(0, 1, length(x_u))', x_u, s_norm, 'pchip');
r_out  = interp1(x_u, r_u, x_out, 'pchip');

fid = fopen(filename, 'w');
fprintf(fid, '3d=true\n');
fprintf(fid, 'polyline=true\n');
for k = 1:N_pts
    fprintf(fid, '1\t%d\t%.8f\t%.8f\t0.00000000\n', k, x_out(k), r_out(k));
end
fclose(fid);
end

function [T_wh_val, q_val, u_val, D_hyd, Re_val] = eval_Twh_canale(H, W, W_rib, N_chan, R_mid, t_wall, k_wall, ...
    m_dot_cool, rho_j, mu_j, k_j, Pr_j, hg_j, Taw_j, T_mid)
A_flow_tot = N_chan*W*H;
D_hyd      = 2*W*H/(W + H);
u_val      = m_dot_cool/(rho_j*A_flow_tot);
Re_val     = rho_j*u_val*D_hyd/mu_j;
Nu_val     = 0.023*Re_val^0.8*Pr_j^0.4;
hc_val     = Nu_val*k_j/D_hyd;

m_fin   = sqrt(2*hc_val/(k_wall*W_rib));
eta_fin = tanh(m_fin*H)/(m_fin*H);
Phi_A   = N_chan*(W + 2*eta_fin*H)/(2*pi*R_mid);

R_th_tot = 1/hg_j + t_wall/k_wall + 1/(hc_val*Phi_A);
q_val    = (Taw_j - T_mid)/R_th_tot;
T_wh_val = Taw_j - q_val/hg_j;
end
